# Copy to .env (which is git-ignored) and adjust as needed.
# docker compose reads .env automatically.

# --- Local Postgres container ---
POSTGRES_PASSWORD=tickettriage
# Host port. 5433 avoids clashing with a locally installed Postgres on 5432.
# If you change it, also change the URL in backend/src/main/resources/application-dev.yml.
POSTGRES_PORT=5433

# --- AI triage ---
# "dev,mock" = sample data + keyword-based fake classifier (no API key needed).
# "dev"      = sample data + real Claude calls (set ANTHROPIC_API_KEY below).
SPRING_PROFILES_ACTIVE=dev,mock
ANTHROPIC_API_KEY=
# Optional. Default: claude-opus-5-5. A cheaper option for high volume: claude-haiku-5-5
ANTHROPIC_MODEL=claude-opus-5-5
