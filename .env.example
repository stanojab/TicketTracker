# Copy to .env (which is git-ignored) and adjust as needed.
# docker compose reads .env automatically.

# --- AI triage ---
# "dev,mock" = 15 sample tickets + keyword-based fake classifier (no API key needed)
# "dev"      = 15 sample tickets + real Claude calls (set ANTHROPIC_API_KEY)
SPRING_PROFILES_ACTIVE=dev,mock
ANTHROPIC_API_KEY=
# Default: claude-opus-5-5. A cheaper option for high volume: claude-haiku-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# --- Database ---
POSTGRES_PASSWORD=tickettriage

# --- Host ports ---
# UI (nginx)                -> http://localhost:8081
FRONTEND_PORT=8081
# API, Swagger UI           -> http://localhost:8090/swagger-ui.html
BACKEND_PORT=8090
# Postgres. 5433 avoids clashing with a local Postgres on 5432.
# If you change it, also change the URL in backend/src/main/resources/application-dev.yml.
POSTGRES_PORT=5433
